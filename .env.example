# =============================================================================
# Monitoramento de Serviços — Template
# Copie este arquivo para .env e preencha com suas credenciais
# =============================================================================

# Chave de API do Google Sheets (v4)
# Crie em: https://console.cloud.google.com/apis/credentials
VITE_SHEETS_API_KEY=coloque_sua_chave_aqui

# ID da planilha Google Sheets (extraído da URL da planilha)
VITE_SPREADSHEET_ID=coloque_o_id_da_planilha_aqui

# Nome da aba com os dados de transação (lançamentos)
VITE_SHEETS_RANGE=transacoes

# Nome da aba com a referência de serviços (secretarias, agrupamentos, etc.)
VITE_REFERENCE_RANGE=referencia_servicos

# URL do Web App do Google Apps Script (para escrita/upsert)
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/SEU_ID/exec

# (Opcional) Base URL para deploy — deixe / para produção no GitHub Pages
VITE_BASE_URL=/